import sys
import subprocess as sp 

def upd_pip():
    try:
        print("Updating pip...")
        sp.check_call([
            sys.executable, '-m', 'pip', 'install', '--upgrade', '--user', 'pip'])
        print("pip updated successfully")
    except subprocess.CalledProcessError as e:
        print(f"Failed to update pip (exit code {e.returncode})")
    
def imp_pyg():
