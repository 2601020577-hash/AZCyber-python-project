import os
import sys
import subprocess as sp 

def packets():
    try:
        import pygame as pyg
        from cryptography.fernet import Fernet as fern
    except ModuleNotFoundError:
        cmd_pip = [sys.executable, '-m', 'pip', 'install', '--upgrade', '--user', 'pip']
        cmd_pyg = [sys.executable,'-m', 'pip', 'install', '--user', 'pygame-ce']
        cmd_crypt = [sys.executable, '-m', 'pip', 'install', '--user', 'cryptography']
        cmds = [cmd_pip, cmd_pyg, cmd_crypt]
        for cmd in cmds:
            sp.check_call(cmd[:-1] + ["--break-system-packages", cmd[-1]])
packets()

import tkinter as tk
import random

def create_popup(window_count):
    root = tk.Tk()
    root.withdraw() 
    
    screen_width = root.winfo_screenwidth()
    screen_height = root.winfo_screenheight()
    
    # Define generic window size
    win_width = 300
    win_height = 120
    for i in range(window_count):
        # Create a separate TopLevel window context
        popup = tk.Toplevel()
        popup.title(f"Status Window {i+1}")
        max_x = max(0, screen_width - win_width)
        max_y = max(0, screen_height - win_height)
        rand_x = random.randint(0, max_x)
        rand_y = random.randint(0, max_y)
        popup.geometry(f"{win_width}x{win_height}+{rand_x}+{rand_y}")
        popup.overrideredirect(True)
        popup.attributes("-topmost", True)
        
        label = tk.Label(popup, text=f"Alert: Process {i+1}\nThis window is anchored.", pady=20)
        label.pack()
    root.mainloop()
if __name__ == "__main__":
    create_popup(5)
