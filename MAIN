import os
import sys
import subprocess as sp 

def packets():
    try:
        import pygame as pyg
        from cryptography.fernet import Fernet as fern
    except ModuleNotFoundError:
        cmd_pip = [sys.executable, '-m', 'pip', 'install', '--upgrade', '--user', 'pip']
        cmd_pyg = [sys.executable,'-m', 'pip', 'install', '--user', 'pygame-ce']
        cmd_crypt = [sys.executable, '-m', 'pip', 'install', '--user', 'cryptography']
        cmds = [cmd_pip, cmd_pyg, cmd_crypt]
        for cmd in cmds:
            sp.check_call(cmd[:-1] + ["--break-system-packages", cmd[-1]])
packets()

file = []
import tkinter as tk
from tkinter import messagebox
def disable_event():
    messagebox.showwarning("Warning", "You cannot close this window!")
root = tk.Tk()
root.title("Persistent Window")
root.geometry("350x150")
root.protocol("WM_DELETE_WINDOW", disable_event)
label = tk.Label(root, text="This window will not close via the X button.", pady=20)
label.pack()
root.mainloop()
